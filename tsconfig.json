{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@features/*": ["src/features/*"],
      "@agents/*": ["src/agents/*"],
      "@llm/*": ["src/llm/*"],
      "@vfs/*": ["src/vfs/*"],
      "@github/*": ["src/github/*"],
      "@ui-reference/*": ["src/ui-reference/*"],
      "@design/*": ["src/design/*"],
      "@i18n/*": ["src/i18n/*"]
    }
  },
  "include": ["src", "android/capacitor.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}